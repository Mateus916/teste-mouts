{
  "name": "serverest-cypress",
  "version": "1.0.0",
  "description": "Automação de testes E2E (frontend) e de API da aplicação ServeRest com Cypress e JavaScript",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:frontend": "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Mateus Teles",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.13.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
